{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "构建扫雷 GUI (minesweeper.exe)",
            "command": "C:/Users/tx/MinGWo/bin/gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/minesweeper.c",
                "-o",
                "${workspaceFolder}/minesweeper.exe",
                "-mwindows",
                "-lgdi32",
                "-luser32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "编译 Win32 图形界面扫雷程序"
        },
        {
